# Copy to .env and adjust. .env is git-ignored - never commit it.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (used by docker compose; leave DB_NAME empty to run Django on SQLite)
DB_NAME=geoplanner
DB_USER=geoplanner
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# OR-Tools search time per TSP solve, in seconds
TSP_TIME_LIMIT_S=10
